<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Paramètres JDBC PostgreSQL -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/malinassur_db</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">postgres</property>

        <!-- Dialecte PostgreSQL -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- Affichage et formatage des requêtes SQL dans les logs -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Validation automatique du schéma SQL par rapport aux entités -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- ===== Socle Utilisateurs (Dev 1) ===== -->
        <mapping class="fr.cytech.malinassur.model.AppUser"/>

        <!-- ===== Module Contrats & Produits (Dev 2) ===== -->
        <mapping class="fr.cytech.malinassur.model.InsuranceType"/>
        <mapping class="fr.cytech.malinassur.model.Coverage"/>
        <mapping class="fr.cytech.malinassur.model.InsuranceTypeCoverage"/>
        <mapping class="fr.cytech.malinassur.model.Contract"/>
        <mapping class="fr.cytech.malinassur.model.ContractCoverage"/>

        <!-- ===== Module Sinistres & Règlements (Dev 3) ===== -->
        <mapping class="fr.cytech.malinassur.model.Claim"/>
        <mapping class="fr.cytech.malinassur.model.SupportingDocument"/>
        <mapping class="fr.cytech.malinassur.model.Payment"/>
    </session-factory>
</hibernate-configuration>